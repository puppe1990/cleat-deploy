[Unit]
Description=Cleat Control Panel
After=network.target

[Service]
Type=exec
User=root
Group=root
WorkingDirectory=/opt/cleat_deploy/current
EnvironmentFile=/etc/cleat_deploy/env
ExecStart=/opt/cleat_deploy/current/bin/server
Restart=always
RestartSec=5
MemoryMax=768M
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target